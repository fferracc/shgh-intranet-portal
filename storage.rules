rules_version = '2';

// Storage rules for shgh-lms1 (moved into the repo 25 Sep 2026). The profilePictures
// block is exactly what was live in the console before.
service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the profilePictures directory
    match /profilePictures/{userId}/{fileName} {

      // Allow anyone to read profile pictures (they are public).
      // If you want them to be private, change to: allow read: if request.auth != null;
      allow read: if true;

      // Allow an authenticated user to create, update, or delete a file
      // ONLY in their own user folder.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Volunteer CVs from the public form (PDF, up to 5 MB). Anyone may upload ONE file
    // for a new application; nobody can read, replace or list them from a browser.
    // Admins open CVs through the getVolunteerCv function, which runs on the server.
    match /volunteerCVs/{applicationId}/{fileName} {
      allow create: if fileName == 'cv.pdf'
        && resource == null
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow read, update, delete: if false;
    }
  }
}
